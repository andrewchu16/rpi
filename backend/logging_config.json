{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "default": {
            "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
        },
        "simple": {
            "format": "%(asctime)s - %(levelname)s - %(message)s"
        },
        "json": {
            "()": "src.logger.JSONFormatter",
            "fmt_keys": {
                "level": "levelname",
                "message": "message",
                "timestamp": "timestamp",
                "logger": "name",
                "module": "module",
                "function": "funcName",
                "line": "lineno",
                "thread_name": "threadName"
            }
        },
        "login": {
            "format": "%(asctime)s - %(levelname)s - %(message)s"
        }
    },
    "filters": {
        "non_error": {
            "()": "src.logger.NonErrorFilter"
        }
    },
    "handlers": {
        "stdout": {
            "class": "logging.StreamHandler",
            "stream": "ext://sys.stdout",
            "formatter": "simple",
            "level": "DEBUG",
            "filters": ["non_error"]
        },
        "stderr": {
            "class": "logging.StreamHandler",
            "stream": "ext://sys.stderr",
            "formatter": "simple",
            "level": "ERROR"
        },
        "file": {
            "class": "logging.handlers.RotatingFileHandler",
            "filename": "logs/backend.log.jsonl",
            "maxBytes": 5000000,
            "backupCount": 5,
            "formatter": "json",
            "level": "DEBUG"
        },
        "login_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "filename": "logs/login_attempts.log",
            "maxBytes": 1000000,
            "backupCount": 3,
            "formatter": "login",
            "level": "INFO"
        },
        "queue_handler": {
            "class": "logging.handlers.QueueHandler",
            "handlers": [
                "stdout",
                "stderr",
                "file"
            ],
            "respect_handler_level": true
        }
    },
    "loggers": {
        "root": {
            "level": "INFO",
            "handlers": [
                "queue_handler"
            ]
        },
        "auth.login": {
            "level": "INFO",
            "handlers": [
                "login_file"
            ],
            "propagate": false
        }
    }
}